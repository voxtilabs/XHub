# xHub — variables de entorno. Copia a .env y completa. Secretos por REFERENCIA
# donde sea posible (ADR 0011): aquí van los de infraestructura local.

# --- Imagen ---
XHUB_IMAGE=ghcr.io/voxtilabs/xhub:staging
XHUB_ENV=staging               # desarrollo | staging | produccion

# --- Base de datos (propia, no gestionada — ADR 0007) ---
POSTGRES_USER=xhub
POSTGRES_PASSWORD=              # REQUERIDO
POSTGRES_DB=xhub
# La app se conecta con un rol NO superusuario (xhub_app); la migración usa el owner.
DATABASE_URL=postgres://xhub:CAMBIAME@postgres:5432/xhub

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Observabilidad (opcional; sin esto, inerte) ---
# Sentry POSPUESTO: lo paga X5, no se cablea todavía. No pongas SENTRY_DSN aún.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Conector xContact (Fase 3) ---
# Referencia a la config WireGuard, NO el secreto en claro.
WG_CONF_REF=
# Clave maestra de la bóveda de credenciales (ADR 0011). Vive SOLO en el entorno,
# nunca en la base ni en los respaldos.
XHUB_CLAVE_MAESTRA=

# --- Dominios (por entorno; no horneados en el build) ---
# Producción:
XHUB_DOMINIO_PANEL=xhub.voxtilabs.cl
XHUB_DOMINIO_API=api-xhub.voxtilabs.cl
XHUB_CORS_ORIGENES=https://xhub.voxtilabs.cl
# Staging: XHUB_DOMINIO_PANEL=stagexhub.voxtilabs.cl · XHUB_DOMINIO_API=api-stagexhub.voxtilabs.cl
